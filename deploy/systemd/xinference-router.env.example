# Non-sensitive configuration for /etc/xinference/router.env.

XINFERENCE_TOKEN_ROUTER_SUPERVISOR_URL=http://xinference-supervisor:9997
XINFERENCE_TOKEN_ROUTER_UID=replace-with-router-uid-from-token-router-ui
XINFERENCE_TOKEN_ROUTER_HOST=10.61.9.11
XINFERENCE_TOKEN_ROUTER_PORT=10080
XINFERENCE_TOKEN_ROUTER_PUBLIC_ENDPOINT=http://10.61.9.11:10080
XINFERENCE_TOKEN_ROUTER_LOG_LEVEL=INFO
# Uvicorn access logs are high-volume and disabled by default. Router lifecycle,
# routing decisions, completions, rejections, and backend failures remain logged.
XINFERENCE_TOKEN_ROUTER_ACCESS_LOG=false

# Xinference-standard application log output for the independent Router process.
XINFERENCE_LOG_FORMAT=json
XINFERENCE_LOG_CONSOLE=false
XINFERENCE_LOG_DIR=/data/inference/logs/router
XINFERENCE_LOG_ROTATION=daily+size
XINFERENCE_LOG_RETENTION_DAYS=30
XINFERENCE_LOG_MAX_BYTES=104857600
XINFERENCE_LOG_BACKUP_COUNT=300
