[Unit]
Description=Xinference Token Router Agent
Documentation=file:///data/inference/deploy/systemd/README-xinference-router-agent.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=cloud
Group=cloud
WorkingDirectory=/data/inference

# Non-sensitive node configuration and dedicated internal credential.
EnvironmentFile=/etc/xinference/router-agent.env
EnvironmentFile=/etc/xinference/router.secret.env

# Direct venv executable execution does not require shell activation.
Environment=VIRTUAL_ENV=/data/inference/.venv
Environment="PATH=/data/inference/.venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
UnsetEnvironment=PYTHONHOME

Environment=PYTHONUNBUFFERED=1
Environment=PYTHONFAULTHANDLER=1
Environment=TOKENIZERS_PARALLELISM=false
Environment=XINFERENCE_HOME=/data/models

ExecStartPre=/usr/bin/test -x /data/inference/.venv/bin/xinference-router-agent
ExecStartPre=/usr/bin/test -x /data/inference/.venv/bin/xinference-router
ExecStart=/data/inference/.venv/bin/xinference-router-agent

Restart=always
RestartSec=5
TimeoutStartSec=120
TimeoutStopSec=7200
KillSignal=SIGTERM
KillMode=control-group
SendSIGKILL=yes

LimitNOFILE=65535
TasksMax=4096
UMask=0027

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

StandardOutput=journal
StandardError=journal
SyslogIdentifier=xinference-router-agent

[Install]
WantedBy=multi-user.target
