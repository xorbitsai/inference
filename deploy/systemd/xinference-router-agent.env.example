# Supervisor control-plane endpoint.
XINFERENCE_TOKEN_ROUTER_SUPERVISOR_URL=http://xinference-supervisor:9997

# Stable Router Agent node identity and Runtime advertised host.
XINFERENCE_TOKEN_ROUTER_NODE_ID=t-xinference-router-001
XINFERENCE_TOKEN_ROUTER_NODE_HOST=10.61.9.11

# Runtime port pool and node capacity.
XINFERENCE_TOKEN_ROUTER_PORT_RANGE_START=10080
XINFERENCE_TOKEN_ROUTER_PORT_RANGE_END=10179
XINFERENCE_TOKEN_ROUTER_MAX_INSTANCES=20
XINFERENCE_TOKEN_ROUTER_RUNTIME_EXECUTABLE=/data/inference/.venv/bin/xinference-router
XINFERENCE_TOKEN_ROUTER_RUNTIME_LOG_ROOT=/data/inference/logs/router-runtime

# Optional comma-separated scheduling metadata.
# XINFERENCE_TOKEN_ROUTER_NODE_LABELS=environment=test,zone=gz-a
# XINFERENCE_TOKEN_ROUTER_TOKENIZER_ASSETS=deepseek-v4-flash-0731

# Agent coordination.
XINFERENCE_TOKEN_ROUTER_AGENT_HEARTBEAT_SECONDS=15
XINFERENCE_TOKEN_ROUTER_AGENT_WATCH_SECONDS=30
XINFERENCE_TOKEN_ROUTER_AGENT_MAX_RESTART_BACKOFF_SECONDS=60
XINFERENCE_TOKEN_ROUTER_AGENT_DRAIN_TIMEOUT_SECONDS=7200
XINFERENCE_TOKEN_ROUTER_LOG_LEVEL=INFO

# Xinference-standard Agent logging.
XINFERENCE_LOG_FORMAT=json
XINFERENCE_LOG_CONSOLE=false
XINFERENCE_LOG_DIR=/data/inference/logs/router-agent
XINFERENCE_LOG_ROTATION=daily+size
XINFERENCE_LOG_RETENTION_DAYS=30
XINFERENCE_LOG_MAX_BYTES=104857600
XINFERENCE_LOG_BACKUP_COUNT=300
